---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudyList from '../../../components/CaseStudyList.astro';

const entries = (await getCollection('case-studies', ({ data }) => data.lang === 'es')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Trabajo" lang="es">
  <h1>Trabajo</h1>
  <div class="mt-12">
    <CaseStudyList entries={entries} lang="es" />
  </div>
</BaseLayout>
