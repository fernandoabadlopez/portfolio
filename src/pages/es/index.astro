---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Network from '../../components/Network.astro';

const entries = (await getCollection('case-studies', ({ data }) => data.lang === 'es')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Fernando Abad López" lang="es">
  <div class="shell home">
    <header class="home-head">
      <h1 class="home-name">Fernando Abad López</h1>
      <p class="home-role">Ingeniero de simulación y gráficos 3D en tiempo real.</p>
    </header>

    <!-- Home is the work index: every case study is a node in the network. -->
    <Network entries={entries} lang="es" />
  </div>
</BaseLayout>
