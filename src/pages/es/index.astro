---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyList from '../../components/CaseStudyList.astro';

const entries = (await getCollection('case-studies', ({ data }) => data.lang === 'es')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Fernando Abad López" lang="es">
  <section>
    <p class="text-fg-muted mb-12 font-mono text-xs tracking-[0.1em] uppercase">
      Fernando Abad López / Portfolio — 2026
    </p>

    <h1 class="text-[clamp(2.5rem,6vw,4.5rem)] leading-none">Fernando Abad López</h1>

    <p class="text-fg-muted mt-4 max-w-[60ch] text-xl">
      Ingeniero de simulación y gráficos 3D en tiempo real.
    </p>
  </section>

  <hr class="border-border mt-16 border-0 border-t" />

  <!-- Home is the work index; the list follows the rule directly. The
       heading's former 4rem gap is preserved as padding-top. -->
  <section class="mt-16 pt-16">
    <CaseStudyList entries={entries} lang="es" />
  </section>
</BaseLayout>
