---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyList from '../../components/CaseStudyList.astro';

const entries = (
  await getCollection('case-studies', ({ data }) => data.lang === 'en' && data.order <= 3)
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Fernando Abad López" lang="en">
  <section>
    <p class="text-fg-muted mb-12 font-mono text-xs tracking-[0.1em] uppercase">
      Fernando Abad López / Portfolio — 2026
    </p>

    <h1 class="text-[clamp(2.5rem,6vw,4.5rem)] leading-none">Fernando Abad López</h1>

    <p class="text-fg-muted mt-4 max-w-[40ch] text-xl">
      Real-time simulation and 3D graphics engineer.
    </p>
  </section>

  <hr class="border-border mt-16 border-0 border-t" />

  <section class="mt-16">
    <h2 class="mt-0 mb-16 text-2xl">Selected work</h2>
    <CaseStudyList entries={entries} lang="en" />
  </section>
</BaseLayout>
