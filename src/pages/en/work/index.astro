---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudyList from '../../../components/CaseStudyList.astro';

const entries = (await getCollection('case-studies', ({ data }) => data.lang === 'en')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Work" lang="en">
  <h1>Work</h1>
  <div class="mt-12">
    <CaseStudyList entries={entries} lang="en" />
  </div>
</BaseLayout>
