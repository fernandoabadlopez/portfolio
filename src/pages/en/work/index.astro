---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const entries = (await getCollection('case-studies', ({ data }) => data.lang === 'en')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Work" lang="en">
  <h1>Work</h1>
  <ul>
    {
      entries.map((entry) => (
        <li>
          <a href={`/en/work/${entry.data.slug}/`}>{entry.data.title}</a>
          <p>{entry.data.tagline}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
