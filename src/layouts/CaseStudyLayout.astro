---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import StackList from '../components/StackList.astro';
import { ui, type Lang } from '../i18n/utils';
import { domainOf } from '../lib/network';
import { splitHyphenated } from '../lib/text';

interface Props {
  title: string;
  tagline: string;
  slug: string;
  stack?: string[];
  order?: number;
  lang?: Lang;
  headings?: MarkdownHeading[];
}

const { title, tagline, slug, stack = [], order = 0, lang = 'en', headings = [] } = Astro.props;
const t = ui[lang].caseStudy;
const sections = headings.filter((heading) => heading.depth === 2);
const domain = domainOf(stack);
---

<BaseLayout title={title} lang={lang}>
  <article class="shell case">
    <header class="case-head">
      <h1 class="case-title">
        {
          splitHyphenated(title).map((part) =>
            part.nowrap ? <span class="nowrap">{part.text}</span> : part.text,
          )
        }
      </h1>
      <p class="case-tagline">{tagline}</p>

      <dl class="params-list">
        <div>
          <dt>{t.node}</dt>
          <dd><span class="node-name" transition:name={`node-${slug}`}>{slug}</span></dd>
        </div>
        <div>
          <dt>{t.runsOn}</dt>
          <dd>{ui[lang].network[domain]}</dd>
        </div>
        {
          stack.length > 0 && (
            <div>
              <dt>{t.stack}</dt>
              <dd>
                <StackList stack={stack} />
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    <div class="case-grid">
      {
        sections.length > 0 && (
          <nav class="case-rail" aria-label={t.sections} data-case-rail>
            <ol>
              {sections.map((section) => (
                <li>
                  <a href={`#${section.slug}`}>{section.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <!-- Seeds the figure counters: fig-major is the case study's order and
           never increments, fig-minor counts figures within this page. -->
      <div class="case-body prose" style={`counter-reset: fig-major ${order} fig-minor 0`}>
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import { initCaseRail } from '../scripts/case-rail';
  import { initFigures } from '../scripts/figures';

  document.addEventListener('astro:page-load', () => {
    initCaseRail();
    initFigures();
  });
</script>
