---
import BaseLayout from './BaseLayout.astro';
import StackList from '../components/StackList.astro';
import type { Lang } from '../i18n/utils';

interface Props {
  title: string;
  tagline: string;
  stack?: string[];
  order?: number;
  lang?: Lang;
}

const { title, tagline, stack = [], order = 0, lang = 'en' } = Astro.props;
---

<BaseLayout title={title} lang={lang}>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="text-fg-muted mt-4 text-lg">{tagline}</p>
      {
        stack.length > 0 && (
          <div class="mt-8">
            <StackList stack={stack} />
          </div>
        )
      }
    </header>

    <hr class="border-border my-12 border-0 border-t" />

    <!-- Seeds the figure counters: fig-major is the case study's order and
         never increments, fig-minor counts placeholders within this page. -->
    <div class="case-body" style={`counter-reset: fig-major ${order} fig-minor 0`}>
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  /*
    Two-column grid: the first track holds the prose at reading width, flush
    left with the rest of the page; the second is trailing space. Content
    defaults to the prose column; media and code span both tracks so they are
    not capped at 68ch.
  */
  .case-body {
    display: grid;
    grid-template-columns: min(var(--width-prose), 100%) 1fr;
  }

  .case-body > :global(*) {
    grid-column: 1;
  }

  .case-body > :global(figure.visual-placeholder),
  .case-body > :global(figure.visual-placeholder-pair),
  .case-body > :global(pre),
  .case-body > :global(.full-width) {
    grid-column: 1 / -1;
  }
</style>
