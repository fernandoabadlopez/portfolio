---
import LanguageSwitch from './LanguageSwitch.astro';
import { navItems, path, ui, sectionTrail, isActiveRoute, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const labels = ui[lang].nav;
const pathname = Astro.url.pathname;
const trail = sectionTrail(pathname, lang);
---

<header class="site-head" transition:animate="none">
  <nav class="shell site-nav">
    <a href={path('home', lang)} class="brand">NaN</a>

    <ul class="nav-links">
      {
        navItems.map((key) => (
          <li>
            <a
              href={path(key, lang)}
              aria-current={isActiveRoute(pathname, key, lang) ? 'page' : undefined}
            >
              {labels[key]}
            </a>
          </li>
        ))
      }
    </ul>

    <LanguageSwitch lang={lang} />
  </nav>

  {
    trail && (
      <div class="path-bar">
        <p class="shell path">
          {trail.map((segment) => (
            <>
              <span class="path-sep">/</span>
              {segment.href ? <a href={segment.href}>{segment.label}</a> : <span>{segment.label}</span>}
            </>
          ))}
        </p>
      </div>
    )
  }
</header>
