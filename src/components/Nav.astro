---
import LanguageSwitch from './LanguageSwitch.astro';
import { navItems, path, ui, sectionTrail, isActiveRoute, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const labels = ui[lang].nav;
const pathname = Astro.url.pathname;
const trail = sectionTrail(pathname, lang);
---

<header class="bg-bg sticky top-0 z-10">
  <div class="border-border border-b">
    <nav
      class="mx-auto flex w-full max-w-[1200px] flex-wrap items-center justify-between gap-x-3 gap-y-2 px-4 py-4 sm:gap-x-6 sm:px-6 md:px-12"
    >
      <a
        href={path('home', lang)}
        class="font-display shrink-0 text-lg font-black whitespace-nowrap no-underline"
      >
        NaN
      </a>

      <div class="flex items-center gap-3 sm:gap-6">
        <ul
          class="font-body m-0 flex max-w-none list-none gap-3 p-0 text-xs tracking-[0.03em] uppercase sm:gap-6 sm:text-sm sm:tracking-[0.05em]"
        >
          {
            navItems.map((key) => (
              <li class="m-0">
                <a
                  href={path(key, lang)}
                  class:list={[
                    'whitespace-nowrap no-underline hover:underline',
                    isActiveRoute(pathname, key, lang) &&
                      'border-fg border-b-2 pb-[0.3em] hover:no-underline',
                  ]}
                  aria-current={isActiveRoute(pathname, key, lang) ? 'page' : undefined}
                >
                  {labels[key]}
                </a>
              </li>
            ))
          }
        </ul>
        <LanguageSwitch lang={lang} />
      </div>
    </nav>
  </div>

  {
    trail && (
      <div class="border-border border-b">
        <p class="text-fg-muted mx-auto w-full max-w-[1200px] px-6 py-3 font-mono text-xs tracking-[0.1em] uppercase md:px-12">
          {trail.map((segment, i) => (
            <>
              {i > 0 && <span> / </span>}
              {segment.href ? (
                <a
                  href={segment.href}
                  class="text-fg-muted no-underline underline-offset-[0.2em] hover:underline"
                >
                  {segment.label}
                </a>
              ) : (
                segment.label
              )}
            </>
          ))}
        </p>
      </div>
    )
  }
</header>
