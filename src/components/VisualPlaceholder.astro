---
import { assetExists, mediaType } from '../lib/media';
import { ui } from '../i18n/utils';

interface Props {
  /** Drives the box aspect ratio: 16:9 for hero, 4:3 for inline and gallery. */
  kind: 'hero' | 'inline' | 'gallery';
  description: string;
  /** Path to a real asset. Omit to render the pending-asset placeholder. */
  src?: string;
  /** `contain` keeps interface captures whole instead of cropping them. */
  fit?: 'cover' | 'contain';
}

const { kind, description, src, fit = 'cover' } = Astro.props;
const lang = Astro.url.pathname.startsWith('/es/') ? 'es' : 'en';

const media = mediaType(src);

if (media === 'unsupported') {
  console.warn(`VisualPlaceholder received unsupported extension for src: ${src}`);
}

// A declared asset that is not in public/ yet renders the pending placeholder,
// so figures can be wired before their files are recorded.
const isMedia = media === 'video' || media === 'image';
const hasAsset = isMedia && assetExists(src);

if (isMedia && !hasAsset) {
  console.warn(`VisualPlaceholder: ${src} is not in public/ yet, rendering placeholder`);
}
---

<figure class="visual-placeholder figure" data-kind={kind}>
  <figcaption class="fig-bar">
    <span class="fig-label"></span>
    {!hasAsset && <span class="fig-state">{ui[lang].caseStudy.pending}</span>}
  </figcaption>

  <div class:list={['fig-box', !hasAsset && 'is-pending']} data-fit={fit}>
    {
      hasAsset && media === 'video' && (
        <video src={src} autoplay muted loop playsinline preload="metadata" data-autopause />
      )
    }

    {hasAsset && media === 'image' && <img src={src} alt={description} loading="lazy" />}

    {!hasAsset && <p>{description}</p>}
  </div>
</figure>
