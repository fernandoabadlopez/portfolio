---
interface Props {
  kind: 'hero' | 'inline' | 'gallery';
  description: string;
}

const { kind, description } = Astro.props;
---

<figure
  class="visual-placeholder border-border relative my-12 flex items-center justify-center border border-dashed bg-transparent p-8"
  data-kind={kind}
>
  <span class="text-fg-muted absolute top-4 left-4 font-mono text-xs tracking-[0.1em] uppercase">
    {kind} visual
  </span>
  <p class="text-fg-muted font-body m-0 max-w-[40ch] text-center text-sm leading-normal">
    {description}
  </p>
</figure>

<style>
  .visual-placeholder {
    margin-inline: 0;
  }

  .visual-placeholder[data-kind='hero'] {
    aspect-ratio: 16 / 9;
  }

  .visual-placeholder[data-kind='inline'],
  .visual-placeholder[data-kind='gallery'] {
    aspect-ratio: 4 / 3;
  }
</style>
