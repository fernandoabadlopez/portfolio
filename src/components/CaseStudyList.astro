---
import type { CollectionEntry } from 'astro:content';
import StackList from './StackList.astro';
import { path, type Lang } from '../i18n/utils';

interface Props {
  entries: CollectionEntry<'case-studies'>[];
  lang: Lang;
}

const { entries, lang } = Astro.props;
const base = path('work', lang);
---

<ul class="m-0 flex max-w-none list-none flex-col gap-12 p-0">
  {
    entries.map((entry) => (
      <li class="m-0">
        <h2 class="mt-0 mb-2">
          <a href={`${base}${entry.data.slug}/`} class="no-underline hover:underline">
            {entry.data.title}
          </a>
        </h2>
        <p class="text-fg-muted mb-4">{entry.data.tagline}</p>
        <StackList stack={entry.data.stack} />
      </li>
    ))
  }
</ul>
