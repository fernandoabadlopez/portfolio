---
import { alternatePath, languages, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const pathname = Astro.url.pathname;
---

<ul class="lang">
  {
    languages.map((code) => (
      <li>
        {code === lang ? (
          <span aria-current="true">{code}</span>
        ) : (
          <a href={alternatePath(pathname, lang, code)} hreflang={code} lang={code}>
            {code}
          </a>
        )}
      </li>
    ))
  }
</ul>
