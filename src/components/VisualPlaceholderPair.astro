---
import { assetExists, mediaType } from '../lib/media';
import { ui } from '../i18n/utils';

interface Props {
  /** Drives each box's aspect ratio: 16:9 for hero, 4:3 for inline and gallery. */
  kind?: 'hero' | 'inline' | 'gallery';
  descriptionA: string;
  descriptionB: string;
  /** Path to a real asset for each side. Omit either to render its placeholder. */
  srcA?: string;
  srcB?: string;
  /** `contain` keeps interface captures whole instead of cropping them. */
  fit?: 'cover' | 'contain';
}

const {
  kind = 'inline',
  descriptionA,
  descriptionB,
  srcA,
  srcB,
  fit = 'cover',
} = Astro.props;
const lang = Astro.url.pathname.startsWith('/es/') ? 'es' : 'en';

function resolve(src: string | undefined, description: string) {
  const media = mediaType(src);

  if (media === 'unsupported') {
    console.warn(`VisualPlaceholderPair received unsupported extension for src: ${src}`);
  }

  const isMedia = media === 'video' || media === 'image';
  const hasAsset = isMedia && assetExists(src);

  if (isMedia && !hasAsset) {
    console.warn(`VisualPlaceholderPair: ${src} is not in public/ yet, rendering placeholder`);
  }

  return { media, hasAsset, src, description };
}

const boxes = [resolve(srcA, descriptionA), resolve(srcB, descriptionB)];
const pending = boxes.some((box) => !box.hasAsset);
---

<!-- Counts as a single figure: two angles of the same experiment share one
     FIG label. The counter is seeded by .case-body in CaseStudyLayout.astro. -->
<figure class="visual-placeholder-pair figure" data-kind={kind}>
  <figcaption class="fig-bar">
    <span class="fig-label"></span>
    {pending && <span class="fig-state">{ui[lang].caseStudy.pending}</span>}
  </figcaption>

  <div class="fig-pair">
    {
      boxes.map((box) => (
        <div class:list={['fig-box', !box.hasAsset && 'is-pending']} data-fit={fit}>
          {box.hasAsset && box.media === 'video' && (
            <video
              src={box.src}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              data-autopause
            />
          )}

          {box.hasAsset && box.media === 'image' && (
            <img src={box.src} alt={box.description} loading="lazy" />
          )}

          {!box.hasAsset && <p>{box.description}</p>}
        </div>
      ))
    }
  </div>
</figure>
